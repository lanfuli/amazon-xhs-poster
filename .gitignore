config.json
*.local.json

# Drafts output — these are per-day artifacts, not source
drafts/
xhs-amazon-drafts/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/
npm-debug.log*
package-lock.json
tests/node/package-lock.json

# Playwright
test-results/
playwright-report/
playwright/.cache/

